{
  "name": "acces-direct-aide",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "npx tsx dev-server.js",
    "dev:setup": "npx drizzle-kit push && npx tsx scripts/seed.mjs",
    "dev:full": "npx concurrently --names FE,API --prefix-colors cyan,yellow \"npm run dev\" \"npm run dev:api\"",
    "dev:all": "npm run dev:setup && npm run dev:full",
    "build": "vite build && npx tsx scripts/prerender.mjs && npx tsx scripts/generate-sitemap.mjs",
    "build:vercel": "node scripts/vercel-build.mjs",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "npx tsx scripts/seed.mjs",
    "db:studio": "drizzle-kit studio",
    "db:baseline:rdv": "node scripts/db-baseline-rdv.mjs",
    "doctor": "node scripts/doctor-env.mjs",
    "postinstall": "node scripts/generate-build-info.js",
    "lint": "eslint .",
    "lint:strict": "eslint . --config eslint.strict.config.js",
    "lint:strict:baseline": "node scripts/lint-strict-baseline.mjs",
    "lint:strict:baseline:update": "node scripts/lint-strict-baseline.mjs --update",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "typecheck:strict": "tsc -p tsconfig.strict.json --noEmit --pretty false",
    "typecheck:strict:baseline": "node scripts/typecheck-strict-baseline.mjs",
    "typecheck:strict:baseline:update": "node scripts/typecheck-strict-baseline.mjs --update",
    "test": "node scripts/test-run.mjs",
    "test:unit": "vitest run tests/unit/ api/tests/",
    "test:ci": "vitest run tests/unit/ api/tests/ tests/auth_crossing.test.js",
    "test:api": "node scripts/test-run.mjs tests/integration",
    "test:integration": "node scripts/test-run.mjs tests/integration",
    "test:repeat": "node scripts/test-repeat.mjs",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:load": "k6 run tests/load/k6-load-test.js",
    "test:load:smoke": "k6 run tests/load/k6-smoke.js",
    "test:load:local": "k6 run -e BASE_URL=http://localhost:3000 tests/load/k6-load-test.js",
    "test:a11y": "cross-env TEST_A11Y=1 playwright test --reporter=html",
    "audit-a11y": "npx playwright test e2e/accessibility.spec.js",
    "smoke:prod": "node scripts/smoke-prod.mjs",
    "smoke:seo:prod": "node scripts/seo-smoke.mjs",
    "smoke:obs:prod": "node scripts/obs-smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run lint:design-system",
    "preview": "vite preview",
    "diagnostic": "node scripts/diagnostic-env.js",
    "env:check": "node scripts/env-check.mjs",
    "test:db:prod": "node scripts/test-db-production.cjs",
    "test:db:dev": "node scripts/test-db-development.cjs",
    "verify:env": "node scripts/verify-env-consistency.cjs",
    "security:secrets": "node scripts/security-secrets-scan.mjs",
    "security:scan": "npm run security:secrets",
    "security:scan:git": "gitleaks detect --redact --source .",
    "secrets:scan": "npm run security:scan",
    "secrets:scan:git": "npm run security:scan:git",
    "vercel:env:check": "node scripts/vercel-env-sync.mjs",
    "preflight": "npm ci && npm run lint && npm run typecheck && npm test && npm run build && npm run secrets:bundle",
    "secrets:bundle": "node scripts/bundle-secret-scan.mjs dist",
    "lint:design-system": "node scripts/lint-design-system.mjs",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:admin": "docker compose --profile admin up -d",
    "audit": "node scripts/system-audit.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@aws-sdk/s3-request-presigner": "^3.980.0",
    "@google/generative-ai": "^0.24.1",
    "@neondatabase/serverless": "^1.0.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.1.2",
    "@radix-ui/react-avatar": "^1.1.3",
    "@radix-ui/react-checkbox": "^1.1.4",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-context-menu": "^2.2.6",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.6",
    "@radix-ui/react-hover-card": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-menubar": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.3",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toggle": "^1.1.2",
    "@radix-ui/react-toggle-group": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@sentry/node": "^10.34.0",
    "@sentry/react": "^10.34.0",
    "@sindresorhus/slugify": "^3.0.0",
    "@tanstack/react-query": "^5.90.16",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.36.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/edge": "^1.2.2",
    "@vercel/functions": "^3.4.3",
    "@vercel/kv": "^3.0.0",
    "@vercel/speed-insights": "^1.3.1",
    "busboy": "^1.6.0",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.17",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-react": "^8.5.2",
    "fflate": "^0.8.3",
    "framer-motion": "^12.4.7",
    "input-otp": "^1.4.2",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.0",
    "jszip": "^3.10.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "opossum": "^9.0.0",
    "otplib": "^13.3.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.18.0",
    "pino": "^10.3.0",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "react-qr-code": "^2.0.18",
    "react-resizable-panels": "^2.1.7",
    "react-router-dom": "^7.2.0",
    "recharts": "^2.15.1",
    "rss-parser": "^3.13.0",
    "sonner": "^2.0.1",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2",
    "zod": "^4.6.7",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.1",
    "@eslint/js": "^9.19.0",
    "@flydotio/dockerfile": "^0.7.10",
    "@playwright/test": "^1.58.0",
    "@sentry/vite-plugin": "^4.7.0",
    "@storybook/react": "9.1.21",
    "@storybook/react-vite": "9.1.21",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.13.5",
    "@types/opossum": "8.1.9",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.20",
    "axe-playwright": "^2.2.2",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.9",
    "drizzle-prisma-generator": "^0.1.7",
    "eslint": "^9.19.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "jsdom": "^29.0.0",
    "playwright": "^1.58.2",
    "postcss": "^8.5.3",
    "sharp": "^0.35.5",
    "storybook": "9.1.21",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.56.0",
    "undici": "^7.30.1",
    "vite": "^6.4.5",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "diff": "^5.2.0",
    "fast-xml-parser": ">=5.5.7"
  }
}
