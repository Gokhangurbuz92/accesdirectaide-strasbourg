# .env.example — variable NAMES only, never a value (AccesDirectAide, Strasbourg)
#
# · Local development: copy to `.env.local` (never committed) and fill only what you need. The LAB reads ~/.ada-lab/lab.env (scripts/lab-local.mjs).
# · Never put a server secret in a `VITE_*` variable: every VITE_* value is built into the pages sent to every browser.
# · Production gate: `node scripts/release-preflight.mjs`, run with the production environment, must exit 0 — every [REQUIRED-PROD] variable set and
#   no [FORBIDDEN-PROD] variable set. Deployment steps: docs/deployment.md.
# · Values that appeared in git history (SECRET_FINDINGS_CLASSIFICATION.md) are compromised: never reuse one, generate new values.
#
# Markers: [REQUIRED-PROD] the preflight fails without it · [FORBIDDEN-PROD] the preflight fails when it is set · [LOCAL] development, tests or LAB only

# ---------------------------------------------------------------- Database (server)
# [REQUIRED-PROD] pooled connection string (TLS, not localhost); production refuses to start without it
DATABASE_URL=
# direct (non-pooled) connection used by migrations; aliases POSTGRES_URL_NON_POOLING, POSTGRES_PRISMA_URL
DATABASE_URL_UNPOOLED=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
# [REQUIRED-PROD] true: the database server certificate is verified
DATABASE_SSL_VERIFY=
# [LOCAL] throwaway database of the integration suites (never a real database)
DATABASE_URL_TEST=

# ---------------------------------------------------------------- Sessions and administrators (server)
# [REQUIRED-PROD] jwt
AUTH_MODE=
# [REQUIRED-PROD] >= 32 characters; production refuses to start without it
JWT_SECRET=
# session signing secret, >= 32 characters (alias AUTH_JWT_SECRET)
AUTH_SECRET=
AUTH_JWT_SECRET=
# 1 enables sign-in by e-mail link (default 0)
AUTH_MAGICLINK_ENABLED=
# true: an administrator absent from the account registry is refused (always on in production)
ADMIN_SESSION_REGISTRY_STRICT=
# appointment confirmation links, >= 32 characters (otherwise AUTH_SECRET / JWT_SECRET; production refuses without a durable secret)
RDV_CONFIRMATION_TOKEN_SECRET=
SESSION_SECRET=
# Production administrators are NAMED accounts with a password hash and MFA, created with `node scripts/admin-bootstrap.mjs` — never environment variables.
# [FORBIDDEN-PROD] plain-text password; legacy bearer that bypasses MFA
ADMIN_PASSWORD=
ADMIN_TOKEN=
# ignored in production (development sign-in only): remove them there
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=

# ---------------------------------------------------------------- Encryption (server)
# [REQUIRED-PROD] 64 hexadecimal characters: personal data at rest. Rotation adds a key to the ring (ADA_ENCRYPTION_KEY_PREVIOUS) — never overwrite in place.
ADA_ENCRYPTION_KEY=
ADA_ENCRYPTION_KEY_PREVIOUS=
# [REQUIRED-PROD] vault of the MFA secrets (and Outlook tokens): 64 hex or >= 32 characters, distinct from ADA_ENCRYPTION_KEY.
# Former name OUTLOOK_TOKEN_ENCRYPTION_KEY is still read.
ADA_VAULT_KEY=
# R34: ADA Pro second factor. ALWAYS required in production (no switch there). Outside production (LAB, Preview) set to true to require it too.
PRO_MFA_REQUIRED=false

# ---------------------------------------------------------------- Public address (server)
# [REQUIRED-PROD] https public address used in every e-mail link; production refuses to build a link without it (alias PUBLIC_BASE_URL; legacy alias VITE_BASE_URL is still read — never set it: VITE_ values go into the browser bundle)
APP_BASE_URL=
PUBLIC_BASE_URL=

# ---------------------------------------------------------------- E-mail (server)
# [REQUIRED-PROD] a deliverable provider (resend …), a sender and its key. Without them no e-mail is sent.
MAILER_PROVIDER=
MAILER_FROM=
MAILER_API_KEY=
# R42: MAILER_PROVIDER=msgraph sends through Microsoft Graph sendMail from one shared mailbox (application access limited to that mailbox by
# Exchange RBAC for Applications). Certificate (PEM pair) preferred over a client secret. See CONTROL/r42/R42_MAIL_IMPLEMENTATION_EN.md.
MAILER_MSGRAPH_TENANT_ID=
MAILER_MSGRAPH_CLIENT_ID=
MAILER_MSGRAPH_SENDER=
MAILER_MSGRAPH_CERT_PEM=
MAILER_MSGRAPH_CERT_PRIVATE_KEY=
MAILER_MSGRAPH_CLIENT_SECRET=
# R43: Mailjet extras. MAILER_MAILJET_SANDBOX=1 = Mailjet validates every message and delivers none (genuine provider test, no e-mail). MAILER_REPLY_TO =
# the Reply-To of every message (contact@…). MAILER_EVENTS_ENABLED=1 opens POST /api/monitor/mail-events/mailjet (delivery events; basic auth below, the
# password >= 24 characters, written in Mailjet's callback URL). See CONTROL/r43/R43_GUIDE_CONFIGURATION_MAIL_FR.md.
MAILER_MAILJET_SANDBOX=
MAILER_REPLY_TO=
MAILER_EVENTS_ENABLED=
MAILER_EVENTS_BASIC_USER=
MAILER_EVENTS_BASIC_PASSWORD=

# ---------------------------------------------------------------- Scheduled jobs (server)
# [REQUIRED-PROD] >= 24 characters; Vercel Cron sends it as `Authorization: Bearer …` (the ?secret= query is refused in production)
CRON_SECRET=
# R33 — the weekly GDPR purge deletes nothing unless this is exactly « true » (set it only once the retention periods are approved)
GDPR_PURGE_ENABLED=false
# R44 / E16 — and only for an APPROVED retention policy (api/_services/retention-policy.js, today PROPOSED — NOT APPROVED): the policy version this
# deployment pins, and the explicit list of approved step ids (comma separated, no wildcard). Anything else = dry run (counts, nothing deleted).
GDPR_PURGE_POLICY_VERSION=
GDPR_PURGE_APPROVED_STEPS=
CRON_ACTUALITES_STALE_MINUTES=
CRON_ACTUALITES_FAIL_MINUTES=
DATA_AIDES_STALE_DAYS=
DATA_DEMARCHES_STALE_DAYS=
DATA_STRUCTURES_STALE_DAYS=
DATA_REVIEW_SCAN_LIMIT_PER_TYPE=
DATA_REVIEW_SCAN_CRON_LIMIT_PER_TYPE=
DATA_REVIEW_SCAN_CRON_ENABLED=
# 1 enables the scheduled link check (default off: it requests nothing)
LINK_CHECK_ENABLED=
MONITOR_DQ_OPEN_TOTAL_MAX=
MONITOR_DQ_OPEN_P0_MAX=
MONITOR_INGEST_FRESHNESS_MAX_AGE_HOURS=

# ---------------------------------------------------------------- Rate limits and sessions store: Upstash KV (server)
# [REQUIRED-PROD] sign-in, sign-up, booking, contact and administration fail closed without it (aliases UPSTASH_KV_REST_API_*, UPSTASH_KV_KV_REST_API_*)
# legacy aliases still READ by api/_utils/env.js — do not provision them, set the canonical KV_REST_API_* only: UPSTASH_KV_KV_REST_API_URL, UPSTASH_KV_KV_REST_API_TOKEN, UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_KV_REST_API_URL=
UPSTASH_KV_REST_API_TOKEN=
PRO_RDV_RATE_LIMIT_READ_PER_MIN=
PRO_RDV_RATE_LIMIT_WRITE_PER_MIN=
PRO_RDV_RATE_LIMIT_WRITE_PER_DAY=

# ---------------------------------------------------------------- File storage (server)
# [REQUIRED-PROD] S3-compatible bucket in the EU under a DPA (Coffre, attachments)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# [LOCAL] directory of the local filesystem storage
ADA_LOCAL_STORAGE_DIR=

# ---------------------------------------------------------------- Public content (server)
# strict (default; always strict in production) · lab: also shows records that are not verified yet — [FORBIDDEN-PROD] lab
ADA_PUBLIC_CONTENT_MODE=
# [FORBIDDEN-PROD] 1: a bare share link would open a dossier again (legacy read)
ADA_LEGACY_SHARE_READ=
# feature switches: true disables public reports / the help form; true enables the territorial statistics export (licence to be decided)
PUBLIC_FEEDBACK_DISABLED=
SUPPORT_FORM_DISABLED=
OPEN_DATA_EXPORT_ENABLED=
# 1 serves the maintenance page to every visitor (preflight warning)
MAINTENANCE_MODE=
# Restricted public beta (owner directive 29/10/2026): 1 = the API serves only the public read-only information routes (api/_utils/public-beta.js);
# accounts, bookings, uploads, sharing, forms, the assistant, administration and crons are refused server-side.
ADA_PUBLIC_BETA_RESTRICTED=
# R43 (E1): « open » = public structure self-registration (POST /api/pro/auth/register). Empty = closed during the beta even when « pro » is open,
# and in Production outside the beta; structures come from the platform and their members join by invitation.
ADA_PRO_SELF_REGISTRATION=
# R43 (E2): « full » = the « accounts » surface opens the whole citizen space; empty = booking scope only (sign-up/in, rights, profile, adult statement)
ADA_BETA_ACCOUNTS_SCOPE=
# build-time mirrors of ADA_BETA_OPEN_SURFACES and the two switches above (screens only; the server is the protection)
VITE_PUBLIC_BETA_OPEN_SURFACES=
VITE_PUBLIC_BETA_ACCOUNTS_SCOPE=
VITE_PUBLIC_BETA_PRO_SELF_REGISTRATION=
# R42 (DEC-R42-01): account-free booking is retired. This variable no longer enables anything: every rdv/guest/* route answers
# 410 ACCOUNT_REQUIRED whatever its value. Kept only so older environments do not fail validation.
ADA_GUEST_BOOKING_ENABLED=
# true = the browser shows the « Bêta publique » notice and closes the account, booking and upload screens (build-time)
VITE_PUBLIC_BETA=
# ADR-022: « on » loads the audience measurement (Vercel Web Analytics + Speed Insights) outside the beta; empty = no measurement (build-time)
VITE_AUDIENCE_MEASUREMENT=
# Legal identity shown in the legal pages (build-time; kept out of the public source code). Production builds fail the release gate until all five are set.
VITE_LEGAL_PUBLISHER_IDENTITY=
# R44: controller identity in the privacy notice (name + « personne physique, porteur du projet »; never the domicile). Unset = the publisher identity.
VITE_LEGAL_CONTROLLER_IDENTITY=
VITE_LEGAL_PUBLICATION_DIRECTOR=
VITE_LEGAL_DATA_PROTECTION_CONTACT=
VITE_LEGAL_SECURITY_CONTACT=
VITE_LEGAL_RIGHTS_HOLDER=
# R45 (ENG-LR-4): LCEN publisher variant. Empty = the legal notice as today. A_II = art. 1-1 II (identification kept by the host);
# A_I = art. 1-1 I 1° (name, domicile, telephone) — only with the separate owner approval below. Any other value fails the build check.
VITE_LEGAL_PUBLISHER_MODE=
# A_I only: exactly « yes-owner-approved », set by the owner himself after a separate explicit decision to publish the domicile
VITE_LEGAL_A_I_ADDRESS_PUBLICATION_APPROVED=
# A_I only, BUILD-ONLY (never VITE_*, never in the repository): injected into the page only when A_I is approved (vite.config.js)
LEGAL_A_I_PUBLISHER_DOMICILE=
LEGAL_A_I_PUBLISHER_PHONE=
# A_II: the publication / right-of-reply contact address (fact F5); empty = « en cours de désignation »
VITE_LEGAL_PUBLICATION_CONTACT_EMAIL=
# A_I and A_II: the host's telephone once obtained from Vercel (Vercel publishes none); empty = placeholder and the build check fails
VITE_LEGAL_HOST_PHONE=
# R45 (ENG-LR-5): versions of the draft legal documents approved by the owner (comma-separated « id@version » or the draft package version)
VITE_LEGAL_DOCS_APPROVED_VERSION=
# LAB only: 1 = the unapproved drafts render with a « Projet — non approuvé » banner (refused in a Production build)
VITE_LEGAL_DRAFT_PREVIEW=

# ---------------------------------------------------------------- Automatic verification — veille (server / LAB)
# extra official domains accepted as sources, comma-separated
ADA_VERIFICATION_EXTRA_DOMAINS=
ADA_VERIFICATION_MIN_GAP_MS=
# minutes per scheduled run (default 4)
ADA_VEILLE_MAX_MINUTES=
# [LOCAL] LAB server: inline runner, local-model texts (on), disk/memory guard (on)
ADA_VEILLE_RUNNER=
ADA_VEILLE_TEXTS=
ADA_VEILLE_RESOURCE_GUARD=
ADA_VEILLE_CACHE_DIR=

# ---------------------------------------------------------------- Data sources (server)
AIDES_TERRITOIRES_API_KEY=
SERVICE_PUBLIC_DEMARCHES_DATASET_URL=
SERVICE_PUBLIC_DEMARCHES_MODE=
FINESS_DATASET_URL=
FINESS_DEPARTMENTS=
RNA_API_BASE_URL=
RNA_DEPARTMENTS=
INGESTION_PARSER_VERSION=
INGESTION_DRY_RUN=
INGESTION_MAX_ITEMS_PER_RUN=
COG_BATCH_SIZE=
# QPV geography service
SIG_VILLE_API_URL=
SIG_VILLE_API_KEY=
# OpenFisca (canonical OPENFISCA_URL; alias OPENFISCA_API_URL)
OPENFISCA_URL=
OPENFISCA_API_URL=
# OPENFISCA_TIMEOUT_MS is NOT read: the timeout is fixed at 5 s in the hash-pinned adapter api/lib/openfiscaClient.js (R15 env reconciliation)
# OPENFISCA_TIMEOUT_MS=
OPENFISCA_ENABLE_TRACE=
ALLOW_OPENFISCA_PUBLIC_PROTOTYPE=
# R15: version of openfisca-france served at OPENFISCA_URL (e.g. 176.1.6), shown with every estimate; blank = « version non déclarée »
OPENFISCA_FRANCE_VERSION=
# Démarches Simplifiées (off by default)
DS_API_URL=
DS_GRAPHQL_TOKEN=
DS_DEMARCHE_IDS=
ENABLE_DS_INGESTION=

# ---------------------------------------------------------------- External providers — OFF until approved (contract, DPA, DPIA)
# Video: VIDEO_PROVIDER=jitsi-jwt + domain, app id, secret >= 32; production also needs VIDEO_PRODUCTION_APPROVED=true (docs/pkg3-video-activation.md)
VIDEO_PROVIDER=
VIDEO_JITSI_DOMAIN=
VIDEO_JITSI_APP_ID=
VIDEO_JITSI_SECRET=
VIDEO_PRODUCTION_APPROVED=
VIDEO_SANDBOX=
# Outlook calendar free/busy (Calendars.ReadBasic). Off unless true; in production it also needs CALENDAR_PRODUCTION_APPROVED=true, the app credentials,
# OUTLOOK_REDIRECT_URI=https://<APP_BASE_URL host>/api/auth/callback/outlook, ADA_VAULT_KEY and (beta) the appointments surface — release gate R43 (E4)
OUTLOOK_ENABLED=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REDIRECT_URI=
# R42: Graph base URL override for tests only (default https://graph.microsoft.com/v1.0)
OUTLOOK_GRAPH_BASE_URL=
# SIAO interoperability
SIAO_ENABLED=
SIAO_API_URL=
SIAO_API_KEY=
# SMS (N02: disabled)
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# AI: only a local model (Ollama) on a trusted machine. [FORBIDDEN-PROD] GEMINI_API_KEY / GOOGLE_API_KEY until a provider is approved.
ENABLE_AI_AGENT=
AI_PRIMARY_PROVIDER=
AI_PRIMARY_MODEL=
AI_FALLBACK_PROVIDER=
AI_FALLBACK_MODEL=
AI_EMBEDDING_PROVIDER=
ALLOW_TRUSTED_INTERNAL_OLLAMA=
OLLAMA_BASE_URL=
OLLAMA_MODEL=
OLLAMA_EMBED_MODEL=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# ---------------------------------------------------------------- Monitoring (server + build)
# error tracking (EU region *.ingest.de.sentry.io, DPA); preflight warning without it, failure if not in the EU region
SENTRY_DSN=
VITE_SENTRY_DSN=
# share of server performance traces sent, 0 to 1 (default 0.1; errors are not sampled)
SENTRY_TRACES_SAMPLE_RATE=
# [FORBIDDEN-PROD] true: session replay (needs consent and DPIA A1)
VITE_SENTRY_REPLAY=
# build only (source-map upload; the maps are deleted from the build afterwards): never at runtime
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# [REQUIRED-PROD] https webhook: operational alerts must reach a person
ALERT_WEBHOOK_URL=
# R36: or/and an address that receives the alerts by e-mail through the site's mail provider (MAILER_PROVIDER resend or mailjet)
ALERT_EMAIL=
LOG_LEVEL=

# ---------------------------------------------------------------- Front-end (public, built into the pages)
# empty: same origin (the default on Vercel)
VITE_API_BASE_URL=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_DEPLOY_ENV=
VITE_VERCEL_ENV=
VITE_GIT_COMMIT_SHA=
VITE_PUBLIC_ENABLE_LOGGING=
# 1 prerenders public pages and the sitemap at build time
ENABLE_PRERENDER=

# ---------------------------------------------------------------- Backups (operator's machine only — never in the Vercel environment)
# 64 hex characters, distinct from ADA_ENCRYPTION_KEY: encrypts scripts/db-backup.mjs archives (keep it outside the backups)
BACKUP_ENCRYPTION_KEY=
# restore target of scripts/db-restore.mjs (always explicit, never DATABASE_URL)
TARGET_DATABASE_URL=

# ---------------------------------------------------------------- Development only — [FORBIDDEN-PROD] when true / 1
VITE_DEV_LOGIN_ENABLED=
VITE_PUBLIC_DIAGNOSTICS=
ALLOW_DEV_TOOLS=
ADA_ALLOW_LEGACY_ADMIN_TOKEN=
USE_MOCKS=
VITE_USE_MOCKS=
VITE_SKIP_DB=
CACHE_DEBUG_HEADERS=
# /api/version details answer only with this token (x-debug-token); without it the endpoint is disabled
DEBUG_TOKEN=

# ---------------------------------------------------------------- R13: read by the code but undocumented until the environment-variable audit (27/10/2026)
# Outlook calendar vault key (32+ characters, server secret; required as soon as OUTLOOK_ENABLED=true; ADA_VAULT_KEY is the canonical vault key, this is its alias)
OUTLOOK_TOKEN_ENCRYPTION_KEY=
# test authority for the Outlook OAuth flow (sandbox only; empty = Microsoft's login.microsoftonline.com)
OUTLOOK_AUTHORITY_URL=
# production switch for the Outlook calendar, after the Microsoft app review and the DPO/security approvals (true / empty)
CALENDAR_PRODUCTION_APPROVED=
# Web Push (N04): VAPID key pair in base64url (generate once, server secrets, never reuse a leaked pair) and the contact (mailto: or https:); without all three the channel is unavailable
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_SUBJECT=
# extra push-service hosts accepted outside production (tests only; ignored in production)
WEB_PUSH_TEST_HOSTS=
# data·inclusion restricted API token (D05; optional: the veille reads the open weekly export without it)
DATA_INCLUSION_API_TOKEN=
# SMS (N02) inbound STOP webhook address registered at the provider; not routed yet (see docs) — keep empty
SMS_INBOUND_URL=
# veille schedule and guards: ADA_VEILLE=off stops the schedule; ADA_VERIFICATION_NETWORK=off stops every request to official sources
ADA_VEILLE=
ADA_VERIFICATION_NETWORK=
# a verification older than this many days is no longer « verified » publicly (default in api/lib/publicVisibility.js)
ADA_VERIFICATION_MAX_AGE_DAYS=
# what happens to a public record whose texts can no longer be rewritten: excerpt (official verbatim excerpt, existing public records only) or withdraw
ADA_VEILLE_TEXT_FALLBACK=
# LAB resource guard (machine running the local model): free disk floor (GiB, default 10), swap ceiling (GiB, default 12), free memory floor (%, default 25), model threads
ADA_VEILLE_MIN_FREE_GB=
ADA_VEILLE_MAX_SWAP_GB=
ADA_VEILLE_MIN_MEMORY_PCT=
ADA_VEILLE_MODEL_THREADS=
# alert when the last successful veille is older than this many hours (default 48)
ALERT_VEILLE_STALE_HOURS=
# R44-MAIL: alert (cron/health-alert, only while MAILER_EVENTS_ENABLED=1) when the Mailjet events report this many bounces + suppressions, or refused
# events, in one hour (default 10)
ALERT_MAIL_BOUNCE_BURST=
# age policy override (JSON, see api/lib/agePolicy.js); empty = the built-in policy
ADA_AGE_POLICY_JSON=
# local embeddings endpoint (default http://127.0.0.1:11434/api/embeddings; OLLAMA_URL is its former name)
OLLAMA_EMBED_URL=
OLLAMA_URL=
# outside production: require a durable appointment-token secret like production does (1 / empty)
WS7_REQUIRE_DURABLE_RDV_SECRET=
# production only: allow clearing the ingestion source registry (maintenance; keep empty)
ALLOW_CLEAR_REGISTRY=
# legacy aliases still read (prefer the canonical names above): WEBHOOK_URL = ALERT_WEBHOOK_URL; MAILJET_API_KEY / MAILJET_SECRET_KEY = MAILER_API_KEY « public:secret »;
# R2_ACCESS_KEY_ID = STORAGE_ACCESS_KEY_ID (health page only); BYPASS_SECRET is FORBIDDEN in production (leaked in history)
WEBHOOK_URL=
MAILJET_API_KEY=
MAILJET_SECRET_KEY=
R2_ACCESS_KEY_ID=
# packages/shared feature switches and logger name (the API reads its own flags; these concern the shared package only)
ENABLE_RAG=
ENABLE_OPENFISCA=
ENABLE_CACHE=
ENABLE_AUDIT_LOG=
SERVICE_NAME=
# Vite build-time only (local sandbox builds of the release tooling; never set on the hosting)
ADA_STAGE6_SANDBOX=
VITE_ENV=

# ---------------------------------------------------------------- Self-hosted Docker only (docker-compose*.yml)
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DOMAIN_NAME=
SSL_EMAIL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# R45 (ENG-LR-2) sensitive-service booking — closed by default (see config/activation-manifest.json)
ADA_SENSITIVE_BOOKING_APPROVED=
ADA_HDS_BOOKING_ASSESSED=
ADA_SENSITIVITY_REVIEW_ENFORCED=

# R46 — ProtectedStore (HDS-ready storage boundary of Mon Coffre / dossier files; api/lib/protected-store/CONTRACT.md): lab (default; refused in production / preview) or certified
ADA_PROTECTED_STORE=
# certified host (only after a certified HDS host is contracted): https endpoint, bearer credential (server secret), per-request timeout (ms)
ADA_PROTECTED_STORE_ENDPOINT=
ADA_PROTECTED_STORE_TOKEN=
ADA_PROTECTED_STORE_TIMEOUT_MS=
# R46 / N08 — FranceConnect OIDC adapter (not live): issuer + RP credentials after the DataPass habilitation; production also needs FRANCECONNECT_PRODUCTION_APPROVED=true
FRANCECONNECT_ISSUER=
FRANCECONNECT_CLIENT_ID=
FRANCECONNECT_CLIENT_SECRET=
FRANCECONNECT_REDIRECT_URI=
FRANCECONNECT_POST_LOGOUT_REDIRECT_URI=
FRANCECONNECT_SCOPES=
FRANCECONNECT_ACR_VALUES=
FRANCECONNECT_PRODUCTION_APPROVED=
