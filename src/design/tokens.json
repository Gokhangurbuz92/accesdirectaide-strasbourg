      },
      "background": {
        "value": "#F7F4EE",
        "description": "Fond de page principal"
      }
    },
    "base": {
      "white": {
        "value": "#FFFFFF",
        "description": "Blanc pur - cartes, surfaces"
      }
    },
    "text": {
      "body": {
        "value": "#1A1A1A",
