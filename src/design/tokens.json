{
  "$schema": "https://json-schema.org/draft-07/schema",
  "name": "AccesDirectAide Design Tokens",
  "version": "1.0.0",
  "colors": {
    "brand": {
      "primary": {
        "value": "#002D5A",
        "description": "Couleur principale - texte, icônes fonctionnelles, boutons, liens, focus ring",
