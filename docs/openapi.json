      }
    },
    "/pro/audit/list": {
      "get": {
        "tags": ["Pro"],
        "summary": "Historique d'audit de l'organisation",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Événements d'audit" } }
      }
    },
    "/pro/audit": {
      "get": {
        "tags": ["Pro"],
        "summary": "Dashboard d'audit pro",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Rapport d'audit" } }
      }
    },
    "/pro/reports": {
      "get": {
        "tags": ["Pro"],
        "summary": "Rapports d'activité professionnelle",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Rapports" } }
      }
    },
    "/aides": {
      "get": {
        "tags": ["Core Data"],
        "summary": "Liste des aides sociales",
        "parameters": [
          { "name": "category", "in": "query", "schema": { "type": "string" }, "description": "Filtrer par catégorie" },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Recherche textuelle" },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 }, "description": "Numéro de page" },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 20 }, "description": "Nombre de résultats par page" }
        ],
        "responses": {
          "200": {
            "description": "Liste paginée des aides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AidesList"
                }
              }
            }
          }
        }
      }
    },
    "/aides/{slug}": {
      "get": {
        "tags": ["Core Data"],
        "summary": "Détail d'une aide par slug",
        "parameters": [
          { "name": "slug", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": { "description": "Détail de l'aide" },
          "404": { "description": "Aide non trouvée" }
        }
      }
    },
    "/structures": {
      "get": {
        "tags": ["Core Data"],
        "summary": "Annuaire des structures d'accompagnement",
        "parameters": [
          { "name": "lat", "in": "query", "schema": { "type": "number" }, "description": "Latitude" },
          { "name": "lon", "in": "query", "schema": { "type": "number" }, "description": "Longitude" },
          { "name": "radius", "in": "query", "schema": { "type": "integer" }, "description": "Rayon en km" },
          { "name": "type", "in": "query", "schema": { "type": "string" }, "description": "Type de structure" }
        ],
        "responses": {
          "200": { "description": "Liste des structures" }
        }
      }
    },
    "/demarches": {
      "get": {
        "tags": ["Core Data"],
        "summary": "Liste des démarches administratives",
        "responses": { "200": { "description": "Liste des démarches" } }
