      }
    },
    "/pro/agent-discovery": {
      "get": {
        "tags": ["Pro"],
        "summary": "Découverte d'agents IA disponibles",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Agents disponibles" } }
      }
    },
    "/pro/agent-scheduler": {
      "post": {
        "tags": ["Pro"],
        "summary": "Planification d'un agent IA",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Agent planifié" } }
      }
    },
    "/pro/health-check": {
      "get": {
        "tags": ["Pro"],
        "summary": "Health check espace professionnel",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Services pro opérationnels" } }
      }
    },
    "/pro/notifications/unread-count": {
      "get": {
        "tags": ["Pro"],
