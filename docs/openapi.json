      }
    },
    "/pro/attestation-data": {
      "get": {
        "tags": ["Pro"],
        "summary": "Données pour génération d'attestation officielle",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Données attestation" } }
      }
    },
    "/pro/interop-siao": {
      "post": {
        "tags": ["Pro"],
        "summary": "Interopérabilité SIAO (hébergement d'urgence)",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Données SIAO transmises" } }
      }
    },
    "/pro/system-maintenance": {
      "get": {
        "tags": ["Pro"],
        "summary": "État de maintenance système",
        "security": [{ "BearerAuth": [] }],
