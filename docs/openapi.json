      }
    },
    "/pro/outlook/availability": {
      "get": {
        "tags": ["Pro"],
        "summary": "Synchronisation disponibilités Outlook",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Disponibilités Outlook" } }
      }
