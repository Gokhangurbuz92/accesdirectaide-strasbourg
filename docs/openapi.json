      }
    },
    "/pro/me": {
      "get": {
        "tags": ["Pro"],
        "summary": "Profil du professionnel connecté",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Profil professionnel" },
          "401": { "description": "Non authentifié" }
        }
      }
    },
    "/pro/mfa-setup": {
      "post": {
        "tags": ["Pro"],
        "summary": "Configuration MFA (génération QR code TOTP)",
        "security": [{ "BearerAuth": [] }],
        "responses": { "200": { "description": "Secret TOTP et QR code retournés" } }
      }
    },
    "/pro/slots": {
      "get": {
        "tags": ["Pro"],
        "summary": "Liste des créneaux du professionnel",
