{
  "openapi": "3.0.3",
  "info": {
    "title": "Accès Direct Aide API",
    "version": "1.0.0",
    "description": "Documentation complète de l'API de la plateforme Accès Direct Aide — aide sociale, démarches, structures, rendez-vous professionnels et administration.",
    "contact": {
      "name": "Équipe AccesDirectAide",
      "url": "https://www.accesdirectaide.fr"
    }
  },
  "servers": [
    {
      "url": "https://www.accesdirectaide.fr/api",
      "description": "Production"
    },
    {
      "url": "http://localhost:5173/api",
      "description": "Développement local (Vite proxy)"
    },
    {
      "url": "http://localhost:3000/api",
      "description": "Développement local (API directe)"
    }
  ],
  "tags": [
    { "name": "Health", "description": "Endpoints de santé et monitoring" },
    { "name": "Auth", "description": "Authentification utilisateur / admin" },
    { "name": "Pro Auth", "description": "Authentification professionnelle (MFA, invitations)" },
    { "name": "Pro", "description": "Espace professionnel (dossiers, slots, équipes)" },
    { "name": "Public", "description": "Endpoints publics (passeport, FALC, assistant)" },
    { "name": "Core Data", "description": "Données principales (aides, structures, démarches, actualités)" },
    { "name": "Assistant", "description": "Assistant IA (chat, recommandations, feedback)" },
    { "name": "Diagnostic", "description": "Diagnostic d'éligibilité (OpenFisca)" },
    { "name": "Admin", "description": "Administration (inbox, features, stats, review)" },
    { "name": "Cron", "description": "Tâches planifiées (pipelines, ingestion, backups)" },
    { "name": "Monitor", "description": "Monitoring avancé (data quality, freshness, cron)" },
    { "name": "Share", "description": "Partage de contenu" },
    { "name": "Misc", "description": "PDF, TTS, téléchargements, taxonomie" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check (public)",
        "description": "Vérifie que l'API est opérationnelle. Aucune vérification de dépendance.",
        "responses": {
          "200": {
            "description": "Service opérationnel",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/deep": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check approfondi (protégé)",
        "description": "Vérifie DB, KV, Storage, Cron, Sentry. Requiert authentification admin ou cron.",
        "security": [{ "AdminToken": [] }, { "CronSecret": [] }],
        "responses": {
          "200": { "description": "Tous les services opérationnels" },
          "401": { "description": "Non autorisé" },
          "503": { "description": "Un ou plusieurs services défaillants" }
        }
      }
    },
    "/healthz": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check Kubernetes-compatible",
        "responses": {
          "200": { "description": "OK" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Connexion utilisateur",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": { "description": "JWT Token retourné" },
          "401": { "description": "Identifiants invalides" }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "tags": ["Auth"],
        "summary": "Inscription utilisateur",
        "responses": {
          "201": { "description": "Compte créé, email de vérification envoyé" },
          "400": { "description": "Données invalides" },
          "409": { "description": "Email déjà enregistré" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Déconnexion",
        "responses": {
          "200": { "description": "Session invalidée" }
        }
      }
    },
    "/auth/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Profil de l'utilisateur connecté",
        "security": [{ "BearerAuth": [] }],
        "responses": {
          "200": { "description": "Profil utilisateur" },
          "401": { "description": "Non authentifié" }
        }
      }
    },
    "/auth/verify-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Vérification d'email par token",
        "responses": {
          "200": { "description": "Email vérifié" },
          "400": { "description": "Token invalide ou expiré" }
        }
      }
    },
    "/auth/resend-verification": {
      "post": {
        "tags": ["Auth"],
        "summary": "Renvoi de l'email de vérification",
        "responses": {
          "200": { "description": "Email renvoyé" }
        }
      }
    },
    "/auth/forgot-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Demande de réinitialisation de mot de passe",
        "responses": {
          "200": { "description": "Email de réinitialisation envoyé" }
        }
      }
    },
    "/auth/reset-password": {
      "post": {
        "tags": ["Auth"],
        "summary": "Réinitialisation effective du mot de passe",
        "responses": {
          "200": { "description": "Mot de passe modifié" },
          "400": { "description": "Token invalide" }
        }
      }
    },
    "/auth/callback/outlook": {
      "get": {
        "tags": ["Auth"],
        "summary": "Callback OAuth Outlook",
        "responses": {
          "302": { "description": "Redirection après authentification Outlook" }
        }
      }
    },
    "/pro/auth/login": {
      "post": {
        "tags": ["Pro Auth"],
        "summary": "Connexion professionnelle",
        "responses": {
          "200": { "description": "Pré-authentifié (MFA requis si activé)" },
          "401": { "description": "Identifiants invalides" }
        }
      }
    },
    "/pro/auth/mfa-verify": {
      "post": {
        "tags": ["Pro Auth"],
        "summary": "Vérification MFA (TOTP)",
        "responses": {
          "200": { "description": "MFA validé, JWT retourné" },
          "401": { "description": "Code TOTP invalide" }
        }
      }
    },
    "/pro/auth/register": {
      "post": {
        "tags": ["Pro Auth"],
        "summary": "Inscription professionnelle",
        "responses": {
          "201": { "description": "Compte professionnel créé" }
        }
      }
    },
    "/pro/auth/forgot-password": {
      "post": {
        "tags": ["Pro Auth"],
        "summary": "Réinitialisation mot de passe pro",
        "responses": { "200": { "description": "Email envoyé" } }
      }
    },
    "/pro/auth/reset-password": {
      "post": {
        "tags": ["Pro Auth"],
        "summary": "Réinitialisation effective mot de passe pro",
        "responses": { "200": { "description": "Mot de passe modifié" } }
      }
    },
    "/pro/auth/register-invite": {
      "post": {
