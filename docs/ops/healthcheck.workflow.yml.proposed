# RA-04 — PROPOSED external watchdog. NOT ACTIVE: this file is deliberately outside .github/workflows/ (a new scheduled job needs the owner's approval,
# and pushing a workflow file needs the « workflow » token scope). To activate: copy it to .github/workflows/healthcheck.yml, review the schedule, push.
# Read docs/ops/EXTERNAL_WATCHDOG.md first.
#
# What it does: read-only GETs of public pages and public API endpoints of the production site, from GitHub's runners — outside the platform, so it still
# speaks when the function, the scheduler or the whole deployment is down (the in-platform health check cannot report its own absence).
# It sends no credential, writes nothing, calls no cron route and no administrator route. A failed run notifies the repository owner by e-mail
# (GitHub's default notification for scheduled workflows).
name: External healthcheck
on:
  schedule:
    # Hourly at minute 12 — five minutes after the in-platform health check (minute 7), while the Neon Free compute it woke is still awake: /api/status
    # and /api/health/ready read the database, and a wake-up every 30 minutes around the clock would spend the monthly compute allowance.
    - cron: '12 * * * *'
  workflow_dispatch:
    inputs:
      expected_sha:
        description: 'Optional: the release SHA production must serve (x-release-sha). Empty = only check that the header is present.'
        required: false
        default: ''
permissions: {}
concurrency:
  group: external-healthcheck
  cancel-in-progress: true
jobs:
  probe:
    name: Probe the public site
    runs-on: ubuntu-latest
    timeout-minutes: 5
    env:
      SITE: https://www.accesdirectaide.fr
      EXPECTED_SHA: ${{ github.event.inputs.expected_sha }}
    steps:
      - name: Public pages and public API answer 200
        run: |
          set -uo pipefail
          fail=0
          probe() {   # probe <path> — three attempts, 20 s apart (a cold start is not an outage)
            for attempt in 1 2 3; do
              code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 20 -A 'ada-external-healthcheck' "$SITE$1" || echo 000)
              [ "$code" = 200 ] && { echo "OK   $1"; return 0; }
              sleep 20
            done
            echo "FAIL $1 (last status $code)"; fail=1
          }
          probe /
          probe /aides
          probe /demarches
          probe /structures
          probe /api/health
          probe /api/health/ready
          probe /api/status
          probe /sitemap.xml
          exit $fail
      - name: Public status reports no unavailable component
        run: |
          set -euo pipefail
          body=$(curl -s --max-time 20 -A 'ada-external-healthcheck' "$SITE/api/status")
          echo "$body" | node -e 'let s="";process.stdin.on("data",d=>s+=d).on("end",()=>{const j=JSON.parse(s);const bad=(j.components||[]).filter(c=>c.state==="unavailable"&&c.id!=="assistant").map(c=>c.id);if(!Array.isArray(j.components)||!j.components.length){console.error("FAIL: no components");process.exit(1)}if(bad.length){console.error("FAIL: unavailable: "+bad.join(", "));process.exit(1)}console.log("OK   components: "+j.components.map(c=>c.id+"="+c.state).join(" "))})'
      - name: Release header (x-release-sha)
        run: |
          set -euo pipefail
          got=$(curl -s -D - -o /dev/null --max-time 20 -A 'ada-external-healthcheck' "$SITE/api/health" | awk -F': ' 'tolower($1)=="x-release-sha"{print $2}' | tr -d '\r')
          [ -n "$got" ] || { echo "FAIL: no x-release-sha header"; exit 1; }
          echo "served release: ${got:0:7}"
          # optional: only a manual run that names the expected SHA compares it (a scheduled run cannot know which release is intended)
          if [ -n "${EXPECTED_SHA:-}" ] && [ "${got:0:7}" != "${EXPECTED_SHA:0:7}" ]; then echo "FAIL: production serves ${got:0:7}, expected ${EXPECTED_SHA:0:7}"; exit 1; fi
